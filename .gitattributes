# Normalize line endings: LF everywhere, so diffs stay small across
# Windows / macOS / Linux. (Note: .gitattributes does NOT allow non-ASCII
# comments - they are parsed as attribute names and cause errors.)
* text=auto eol=lf

# Shell scripts must keep LF or they fail on Linux with "bad interpreter".
gradlew text eol=lf
*.sh text eol=lf

# Binary files: never touch them
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.apk binary
*.keystore binary
